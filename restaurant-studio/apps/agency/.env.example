# Environment variables for the agency site.
#
# For development: copy this file to .env.local and fill in what you need. Nothing is required
# to run the site on your own machine. On Vercel: Project Settings > Environment Variables.
# Real values never go in the repository. This file holds placeholders only.

# --- Site address -----------------------------------------------------------------------------
# Optional. Overrides "url" in studio.json, for a preview or staging deployment.
SITE_URL=

# --- Contact form inbox -----------------------------------------------------------------------
# In development, with nothing set, requests are written to the data/ folder on this machine.
# In production both values below are required. Without them the form refuses to send and
# tells the visitor so. They come from the Google Apps Script backend:
# see ../../automation/google-sheets-inbox/README.md
INBOX_GOOGLE_URL=
INBOX_GOOGLE_SECRET=

# Optional. Set to "local" to write to data/ from a production build on your own machine
# (npm run build, then npm start). Leave empty everywhere else.
INBOX_DRIVER=

# Optional. Signs the contact form's tokens. A fresh secret is generated on every build, so set
# this only if tokens should survive a redeploy. Use at least 32 random characters.
FORM_SECRET=

# Optional. The time zone used to date request references. Default: America/Chicago.
STUDIO_TIMEZONE=

# --- Stripe Payment Links, shown on /pay ------------------------------------------------------
# Paste links created in your own Stripe account. Each must start with https://buy.stripe.com/
# A link appears on the page only when its variable is set.
NEXT_PUBLIC_STRIPE_LINK_STARTER_DEPOSIT=
NEXT_PUBLIC_STRIPE_LINK_STARTER_BALANCE=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM_DEPOSIT=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM_BALANCE=
NEXT_PUBLIC_STRIPE_LINK_CATERING_DEPOSIT=
NEXT_PUBLIC_STRIPE_LINK_CATERING_BALANCE=
NEXT_PUBLIC_STRIPE_LINK_MAINTENANCE=

# --- Live sample sites, linked from /work -----------------------------------------------------
# Where the two sample restaurants are deployed. Without these (and without a url in
# studio.json) the page shows screenshots only, never a dead link.
NEXT_PUBLIC_DEMO_HIBANA_URL=
NEXT_PUBLIC_DEMO_BULMAT_URL=
