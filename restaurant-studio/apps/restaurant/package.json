{
  "name": "restaurant-site-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "client": "tsx scripts/prepare-client.ts",
    "predev": "npm run client --silent",
    "dev": "next dev --port 3001",
    "prebuild": "tsx scripts/prepare-client.ts --fresh-secret",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "npm run client --silent && next typegen && tsc --noEmit",
    "test": "npm run client --silent && vitest run",
    "validate": "tsx scripts/prepare-client.ts --check",
    "schemas": "tsx scripts/write-schemas.ts",
    "new-client": "tsx scripts/new-client.ts",
    "images": "tsx scripts/optimize-images.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
