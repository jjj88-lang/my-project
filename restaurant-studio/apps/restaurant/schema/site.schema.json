{
  "title": "Restaurant site settings (site.json)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "starter",
        "premium"
      ],
      "description": "starter = one-page site. premium = multi-page site with gallery, contact form and more."
    },
    "sample": {
      "default": false,
      "description": "true only for fictional demo sites: shows a 'Sample concept' label and blocks search engines.",
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Restaurant name as guests know it, e.g. \"Hibana\""
    },
    "descriptor": {
      "description": "Short descriptor shown with the name, e.g. \"Hibachi & Sushi\"",
      "type": "string"
    },
    "tagline": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 50,
      "maxLength": 200,
      "description": "One or two sentences for search results and link previews."
    },
    "cuisines": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "priceRange": {
      "type": "string",
      "enum": [
        "$",
        "$$",
        "$$$",
        "$$$$"
      ]
    },
    "url": {
      "type": "string",
      "pattern": "^https?:\\/\\/[^\\s]+$",
      "description": "The site's public address. Used for search engines and link previews."
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA time zone, e.g. \"America/Chicago\" or \"America/New_York\". Drives the \"Open now\" badge."
    },
    "logo": {
      "default": {},
      "type": "object",
      "properties": {
        "image": {
          "description": "Logo file in images/ (SVG or PNG with transparent background)",
          "type": "string"
        },
        "imageAlt": {
          "type": "string"
        },
        "text": {
          "description": "Wordmark text if there is no logo image. Defaults to the name.",
          "type": "string"
        },
        "mark": {
          "description": "Small line-art mark shown next to the wordmark",
          "type": "string",
          "enum": [
            "flame",
            "nigiri",
            "maki",
            "sake",
            "bowl",
            "grill",
            "rings",
            "leaf",
            "chopsticks",
            "fish",
            "tongs",
            "cup"
          ]
        }
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6})$"
            },
            "text": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6})$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6})$",
              "description": "Brand color for buttons and highlights"
            },
            "accentText": {
              "description": "Text color on top of the accent color. Picked automatically if omitted.",
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6})$"
            },
            "surface": {
              "description": "Card background. Derived from background if omitted.",
              "type": "string",
              "pattern": "^#(?:[0-9a-fA-F]{6})$"
            }
          },
          "required": [
            "background",
            "text",
            "accent"
          ]
        },
        "fonts": {
          "default": "editorial",
          "type": "string",
          "enum": [
            "editorial",
            "modern",
            "classic"
          ]
        },
        "corners": {
          "default": "soft",
          "type": "string",
          "enum": [
            "sharp",
            "soft",
            "round"
          ]
        },
        "hero": {
          "default": "cinematic",
          "description": "cinematic = full-width photo behind the headline. split = headline beside the photo.",
          "type": "string",
          "enum": [
            "cinematic",
            "split"
          ]
        }
      },
      "required": [
        "colors"
      ]
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "minLength": 7,
          "description": "As displayed, e.g. \"(785) 555-0142\""
        },
        "email": {
          "description": "Public business email shown on the site (optional)",
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "address": {
          "type": "object",
          "properties": {
            "street": {
              "type": "string",
              "minLength": 1
            },
            "street2": {
              "type": "string"
            },
            "city": {
              "type": "string",
              "minLength": 1
            },
            "region": {
              "type": "string",
              "minLength": 2,
              "description": "State abbreviation, e.g. \"KS\""
            },
            "postalCode": {
              "type": "string",
              "minLength": 3
            },
            "country": {
              "default": "US",
              "type": "string"
            }
          },
          "required": [
            "street",
            "city",
            "region",
            "postalCode"
          ]
        },
        "geo": {
          "type": "object",
          "properties": {
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lng": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "lat",
            "lng"
          ]
        },
        "mapsUrl": {
          "description": "Link to the restaurant's Google Maps listing. If omitted, a directions link is built from the address.",
          "type": "string",
          "pattern": "^https?:\\/\\/[^\\s]+$"
        },
        "neighborhood": {
          "description": "e.g. \"Downtown\" or \"next to the Westridge Mall\"",
          "type": "string"
        },
        "parking": {
          "type": "string"
        }
      },
      "required": [
        "phone",
        "address"
      ]
    },
    "hours": {
      "type": "object",
      "properties": {
        "regular": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "days": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "mon",
                    "tue",
                    "wed",
                    "thu",
                    "fri",
                    "sat",
                    "sun"
                  ]
                }
              },
              "open": {
                "type": "string",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              },
              "close": {
                "type": "string",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
                "description": "May be after midnight, e.g. open 17:00, close 01:00"
              }
            },
            "required": [
              "days",
              "open",
              "close"
            ]
          }
        },
        "notes": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exceptions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "label": {
                "description": "e.g. \"Thanksgiving\"",
                "type": "string"
              },
              "closed": {
                "default": false,
                "type": "boolean"
              },
              "open": {
                "type": "string",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              },
              "close": {
                "type": "string",
                "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "required": [
              "date"
            ]
          }
        }
      },
      "required": [
        "regular"
      ]
    },
    "links": {
      "default": {
        "social": {}
      },
      "type": "object",
      "properties": {
        "order": {
          "type": "object",
          "properties": {
            "url": {
              "description": "Leave out until the client's real link is known",
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "description": "e.g. \"Toast\", \"Square\", \"OpenTable\"",
              "type": "string"
            }
          }
        },
        "reserve": {
          "type": "object",
          "properties": {
            "url": {
              "description": "Leave out until the client's real link is known",
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "description": "e.g. \"Toast\", \"Square\", \"OpenTable\"",
              "type": "string"
            }
          }
        },
        "giftCards": {
          "type": "object",
          "properties": {
            "url": {
              "description": "Leave out until the client's real link is known",
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "provider": {
              "description": "e.g. \"Toast\", \"Square\", \"OpenTable\"",
              "type": "string"
            }
          }
        },
        "social": {
          "default": {},
          "type": "object",
          "properties": {
            "instagram": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "facebook": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "tiktok": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "yelp": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            },
            "google": {
              "type": "string",
              "pattern": "^https?:\\/\\/[^\\s]+$"
            }
          }
        }
      }
    },
    "announcement": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "href": {
          "type": "string"
        },
        "until": {
          "description": "Stop showing the announcement after this date",
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "text"
      ]
    },
    "hero": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "subhead": {
          "type": "string"
        },
        "media": {
          "default": {
            "focus": "center"
          },
          "type": "object",
          "properties": {
            "image": {
              "description": "File name inside the client's images/ folder, e.g. \"hero.jpg\"",
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "description": "What the photo shows, for screen readers and search engines. Required with an image.",
              "type": "string"
            },
            "art": {
              "description": "Line-art motif drawn when there is no photo",
              "type": "string",
              "enum": [
                "flame",
                "nigiri",
                "maki",
                "sake",
                "bowl",
                "grill",
                "rings",
                "leaf",
                "chopsticks",
                "fish",
                "tongs",
                "cup"
              ]
            },
            "focus": {
              "default": "center",
              "description": "Which part of the photo to keep when it is cropped",
              "type": "string",
              "enum": [
                "center",
                "top",
                "bottom",
                "left",
                "right"
              ]
            }
          }
        },
        "embers": {
          "default": false,
          "description": "Slow rising sparks over the hero (suits grill and fire concepts)",
          "type": "boolean"
        }
      },
      "required": [
        "headline"
      ]
    },
    "intro": {
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "media": {
          "type": "object",
          "properties": {
            "image": {
              "description": "File name inside the client's images/ folder, e.g. \"hero.jpg\"",
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "description": "What the photo shows, for screen readers and search engines. Required with an image.",
              "type": "string"
            },
            "art": {
              "description": "Line-art motif drawn when there is no photo",
              "type": "string",
              "enum": [
                "flame",
                "nigiri",
                "maki",
                "sake",
                "bowl",
                "grill",
                "rings",
                "leaf",
                "chopsticks",
                "fish",
                "tongs",
                "cup"
              ]
            },
            "focus": {
              "default": "center",
              "description": "Which part of the photo to keep when it is cropped",
              "type": "string",
              "enum": [
                "center",
                "top",
                "bottom",
                "left",
                "right"
              ]
            }
          }
        },
        "highlights": {
          "default": [],
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "text"
            ]
          }
        }
      },
      "required": [
        "heading",
        "body"
      ]
    },
    "featured": {
      "default": {
        "heading": "From the menu"
      },
      "type": "object",
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "heading": {
          "default": "From the menu",
          "type": "string"
        },
        "intro": {
          "type": "string"
        }
      }
    },
    "experiences": {
      "default": [],
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "eyebrow": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "media": {
            "default": {
              "focus": "center"
            },
            "type": "object",
            "properties": {
              "image": {
                "description": "File name inside the client's images/ folder, e.g. \"hero.jpg\"",
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "description": "What the photo shows, for screen readers and search engines. Required with an image.",
                "type": "string"
              },
              "art": {
                "description": "Line-art motif drawn when there is no photo",
                "type": "string",
                "enum": [
                  "flame",
                  "nigiri",
                  "maki",
                  "sake",
                  "bowl",
                  "grill",
                  "rings",
                  "leaf",
                  "chopsticks",
                  "fish",
                  "tongs",
                  "cup"
                ]
              },
              "focus": {
                "default": "center",
                "description": "Which part of the photo to keep when it is cropped",
                "type": "string",
                "enum": [
                  "center",
                  "top",
                  "bottom",
                  "left",
                  "right"
                ]
              }
            }
          },
          "cta": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "href": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "href"
            ]
          }
        },
        "required": [
          "title",
          "body"
        ]
      }
    },
    "gallery": {
      "default": {
        "heading": "Gallery",
        "images": []
      },
      "type": "object",
      "properties": {
        "heading": {
          "default": "Gallery",
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "images": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "image": {
                "type": "string",
                "minLength": 1
              },
              "alt": {
                "type": "string",
                "minLength": 4
              },
              "caption": {
                "type": "string"
              }
            },
            "required": [
              "image",
              "alt"
            ]
          }
        }
      }
    },
    "catering": {
      "default": {
        "enabled": false,
        "form": false,
        "heading": "Catering & private events",
        "intro": "",
        "points": [],
        "serviceTypes": [
          "Pickup",
          "Delivery"
        ],
        "minGuests": 10,
        "maxGuests": 500,
        "leadTimeDays": 3
      },
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "form": {
          "default": false,
          "description": "true when the client bought the Catering Inquiry Automation add-on",
          "type": "boolean"
        },
        "heading": {
          "default": "Catering & private events",
          "type": "string"
        },
        "intro": {
          "default": "",
          "type": "string"
        },
        "points": {
          "default": [],
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "serviceTypes": {
          "default": [
            "Pickup",
            "Delivery"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "minGuests": {
          "default": 10,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxGuests": {
          "default": 500,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "leadTimeDays": {
          "default": 3,
          "description": "Minimum days of notice. Earlier dates are asked to call instead.",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "media": {
          "type": "object",
          "properties": {
            "image": {
              "description": "File name inside the client's images/ folder, e.g. \"hero.jpg\"",
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "description": "What the photo shows, for screen readers and search engines. Required with an image.",
              "type": "string"
            },
            "art": {
              "description": "Line-art motif drawn when there is no photo",
              "type": "string",
              "enum": [
                "flame",
                "nigiri",
                "maki",
                "sake",
                "bowl",
                "grill",
                "rings",
                "leaf",
                "chopsticks",
                "fish",
                "tongs",
                "cup"
              ]
            },
            "focus": {
              "default": "center",
              "description": "Which part of the photo to keep when it is cropped",
              "type": "string",
              "enum": [
                "center",
                "top",
                "bottom",
                "left",
                "right"
              ]
            }
          }
        }
      }
    },
    "about": {
      "type": "object",
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "media": {
          "type": "object",
          "properties": {
            "image": {
              "description": "File name inside the client's images/ folder, e.g. \"hero.jpg\"",
              "type": "string",
              "minLength": 1
            },
            "alt": {
              "description": "What the photo shows, for screen readers and search engines. Required with an image.",
              "type": "string"
            },
            "art": {
              "description": "Line-art motif drawn when there is no photo",
              "type": "string",
              "enum": [
                "flame",
                "nigiri",
                "maki",
                "sake",
                "bowl",
                "grill",
                "rings",
                "leaf",
                "chopsticks",
                "fish",
                "tongs",
                "cup"
              ]
            },
            "focus": {
              "default": "center",
              "description": "Which part of the photo to keep when it is cropped",
              "type": "string",
              "enum": [
                "center",
                "top",
                "bottom",
                "left",
                "right"
              ]
            }
          }
        },
        "values": {
          "default": [],
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "text"
            ]
          }
        }
      },
      "required": [
        "heading",
        "body"
      ]
    },
    "faq": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string",
            "minLength": 1
          },
          "a": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "q",
          "a"
        ]
      }
    },
    "footer": {
      "default": {
        "studioCredit": true
      },
      "type": "object",
      "properties": {
        "note": {
          "type": "string"
        },
        "studioCredit": {
          "default": true,
          "description": "Shows a small \"Site by ...\" credit",
          "type": "boolean"
        }
      }
    }
  },
  "required": [
    "plan",
    "name",
    "tagline",
    "description",
    "cuisines",
    "url",
    "timezone",
    "theme",
    "contact",
    "hours",
    "hero",
    "intro"
  ]
}
